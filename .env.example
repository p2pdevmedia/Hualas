DATABASE_URL="postgresql://user:password@localhost:5432/hualas"
NEXTAUTH_SECRET="change-me"
# Local development only. On Vercel, prefer leaving NEXTAUTH_URL unset so NextAuth
# can infer the current host. If you pin it, it must match the exact origin that
# serves sign-in for that environment.
NEXTAUTH_URL="http://localhost:3000"
# Google OAuth must authorize:
# - http://localhost:3000/api/auth/callback/google for local development
# - https://your-domain.com/api/auth/callback/google for production
# Preview/staging hosts need their own authorized callback URL or Google sign-in
# should be disabled there.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
MP_ENVIRONMENT="testing"
MP_PUBLIC_KEY=""
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""
MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
MP_AUTO_RETURN="approved"
MP_BINARY_MODE="false"
MP_MAX_INSTALLMENTS="1"
MP_PREFERENCE_EXPIRES_MINUTES="60"
MP_EXCLUDED_PAYMENT_METHODS=""
MP_EXCLUDED_PAYMENT_TYPES=""
PINATA_JWT=""
BLOB_READ_WRITE_TOKEN=""
PUSHALERT_REST_API_KEY=""
